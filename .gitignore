###############################################################################
#                                                                             #
#  .gitignore for Moodle development                                          #
#                                                                             #
#  1. GENERIC PHP DEVELOPMENT  - editors, OS clutter, backups, tooling        #
#  2. MOODLE SPECIFIC          - rules that only make sense for Moodle        #
#  3. AI ASSISTANTS            - agent instructions, rules, transcripts       #
#  4. CUSTOM / PERSONAL        - team and individual conventions              #
#                                                                             #
#  Anything that is yours alone (your editor, your scratch folders) is better #
#  kept out of this shared file. Use your own global excludes instead:        #
#      git config --global core.excludesFile ~/.gitignore_global              #
#  or, for one repository only, edit .git/info/exclude.                       #
#                                                                             #
#   Copyright 2017-2026 TNG Consulting Inc.                                   #
#   License: MIT                                                              #
#                                                                             #
###############################################################################


###############################################################################
# 1. GENERIC PHP DEVELOPMENT                                                  #
###############################################################################

#------------------------------------------------------------------------------
# 1.1 Operating system clutter
