#------------------------------------------------------------------------------
.env
.env.*
!.env.example

#------------------------------------------------------------------------------
# 1.7 Local development environment
# Per-developer overrides for containerised or virtualised setups.
#------------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml
.vagrant/


###############################################################################
# 2. MOODLE SPECIFIC                                                          #
###############################################################################

#------------------------------------------------------------------------------
# 2.1 Files Moodle generates in the working tree
# Moodle writes a phpunit.xml into each component directory as well as the site
# root, so this pattern must NOT be anchored. Moodle core leaves it unanchored
# for exactly this reason, while anchoring /config.php and /behat.yml.
#------------------------------------------------------------------------------
phpunit.xml
moodle-plugin-ci.phar

#------------------------------------------------------------------------------
# 2.2 Site-level files
# Only relevant when this repository is a full Moodle checkout rather than a
# single plugin. Uncomment the ones that apply.
#------------------------------------------------------------------------------
# /config.php
# /moodledata/
# /behat.yml

#------------------------------------------------------------------------------
# 2.3 Composer dependencies
# Moodle installs plugins from a ZIP and never runs "composer install", so a
# plugin that depends on third-party libraries usually MUST commit vendor/.
# Uncomment only when this repository is an application, not a shipped plugin.
#
# Do NOT ignore composer.json or composer.lock. Moodle core says outright that
# both should be shipped, and the lock file is what makes a build reproducible.
#------------------------------------------------------------------------------
# /vendor/

#------------------------------------------------------------------------------
# 2.4 Never ignore the AMD build output
# Moodle serves amd/build/*.min.js directly; a site never runs a build step, so
# the minified output MUST be committed. Many generic templates ignore build/,
# and such a rule in a developer's own global excludes file would otherwise
# make these files vanish from their commits with no warning.
#
# Rules in this file take precedence over core.excludesFile and over
# .git/info/exclude, so the two lines below actively protect the build output.
# Within THIS file, however, the last matching pattern wins - so never add a
# build/ or dist/ rule below this point.
#------------------------------------------------------------------------------
!**/amd/build/
!**/amd/build/**


###############################################################################
# 3. AI ASSISTANTS AND AGENTIC CODING TOOLS                                   #
#                                                                             #
# Each developer brings their own assistant, so its instructions, rules       #
# and indexes are treated as personal configuration. Several of these         #
# tools also write chat transcripts into the working tree, which can          #
# capture source and occasionally credentials - a second reason to keep       #
# them out of commits.                                                        #
#                                                                             #
# Never ignore .github/ itself: your workflows live there.                    #
###############################################################################

##### Claude Code
.claude/
CLAUDE.md

##### Project-scoped MCP server configuration
# Shared by default upstream. Ignored here so that one developer's server
# list is not imposed on everyone else.
.mcp.json

##### Common agent instruction file (Codex CLI, OpenCode and others)
AGENTS.md

##### Cursor
.cursor/
.cursorrules
.cursorignore
.cursorindexingignore

##### Windsurf / Codeium
.windsurf/
.windsurfrules
.codeiumignore

##### Kiro
.kiro/

##### Aider
# Catches .aider.chat.history.md, .aider.input.history and the tags cache.
.aider*

##### Continue.dev
.continue/

##### Gemini CLI
GEMINI.md
.gemini/

##### Cline
# Exists as both a file and a directory; this pattern catches both.
.clinerules

##### GitHub Copilot
# The instructions file only - never ignore .github/ itself.
.github/copilot-instructions.md


###############################################################################
# 4. CUSTOM / PERSONAL                                                        #
#                                                                             #
# Team and individual conventions. Add your own below, or better still put    #
# purely personal entries in your global excludes or .git/info/exclude so     #
# that other developers do not inherit them.                                  #
###############################################################################

##### Personal notes and scratch directories
# Anchored to the repository root so they cannot swallow a docs/ directory
# belonging to a plugin further down the tree.
docs
vendor
